<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/post_background">

    <!-- Header cố định: có nút quay lại và tiêu đề màn hình ở giữa. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/postHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnPostBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_post_back_button"
            android:clickable="true"
            android:contentDescription="@string/desc_back"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_post_arrow_back" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvPostHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/post_item_title"
            android:textColor="@color/post_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnPostBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnPostBack" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Nội dung form cuộn bên dưới header để màn hình nhỏ vẫn xem được đủ trường. -->
    <ScrollView
        android:id="@+id/postScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/postHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Thẻ ảnh: phần upload sau này sẽ dùng layoutAddPhoto làm vùng bấm. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="176dp"
                android:background="@drawable/bg_post_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PostSectionTitle"
                    android:text="@string/post_photos" />

                <FrameLayout
                    android:id="@+id/layoutAddPhoto"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_post_photo_add"
                    android:clickable="true"
                    android:contentDescription="@string/desc_add_photo"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivPostPhotoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/desc_item_photo"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutAddPhotoPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_post_camera" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/post_add_photo"
                            android:textColor="@color/post_text_hint"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/post_photo_limit"
                    android:textColor="@color/post_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Thẻ loại item: Helper đổi nền active/inactive khi người dùng chọn. -->
            <LinearLayout
                style="@style/PostFormCard"
                android:layout_height="116dp">

                <TextView
                    style="@style/PostSectionTitle"
                    android:text="@string/post_image_url" />

                <EditText
                    android:id="@+id/edtPostImageUrl"
                    style="@style/PostInput"
                    android:hint="@string/post_image_url_hint"
                    android:inputType="textUri" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_post_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PostSectionTitle"
                    android:text="@string/post_item_type" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTypeSale"
                        style="@style/PostTypeButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_post_option_active"
                        android:text="@string/post_type_sale"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tvTypeFree"
                        style="@style/PostTypeButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_post_option_inactive"
                        android:text="@string/post_type_free"
                        android:textColor="#4B5563" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/PostFormCard"
                android:layout_height="116dp">

                <TextView
                    style="@style/PostSectionTitle"
                    android:text="@string/post_title_label" />

                <EditText
                    android:id="@+id/edtPostTitle"
                    style="@style/PostInput"
                    android:hint="@string/post_title_hint"
                    android:inputType="textCapSentences" />

                <LinearLayout
                    style="@style/PostFormCard"
                    android:layout_height="116dp">

                    <TextView
                        style="@style/PostSectionTitle"
                        android:text="@string/post_category" />

                    <TextView
                        android:id="@+id/tvPostCategory"
                        style="@style/PostSelectInput"
                        android:text="@string/post_select_category" />
                </LinearLayout>
            </LinearLayout>

            <!-- Chip tình trạng dùng Flow để tự xuống dòng gọn trên màn hình hẹp. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="152dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_post_card"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvConditionLabel"
                    style="@style/PostSectionTitle"
                    android:text="@string/post_condition"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvConditionNew"
                    style="@style/PostConditionChip"
                    android:text="@string/post_condition_new" />

                <TextView
                    android:id="@+id/tvConditionLikeNew"
                    style="@style/PostConditionChip"
                    android:text="@string/post_condition_like_new" />

                <TextView
                    android:id="@+id/tvConditionGood"
                    style="@style/PostConditionChip"
                    android:text="@string/post_condition_good" />

                <TextView
                    android:id="@+id/tvConditionFair"
                    style="@style/PostConditionChip"
                    android:text="@string/post_condition_fair" />

                <TextView
                    android:id="@+id/tvConditionPoor"
                    style="@style/PostConditionChip"
                    android:text="@string/post_condition_poor" />

                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/flowCondition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="tvConditionNew,tvConditionLikeNew,tvConditionGood,tvConditionFair,tvConditionPoor"
                    app:flow_horizontalAlign="start"
                    app:flow_horizontalGap="8dp"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalGap="8dp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvConditionLabel" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                style="@style/PostFormCard"
                android:layout_height="116dp">

                <TextView
                    style="@style/PostSectionTitle"
                    android:text="@string/post_price" />

                <EditText
                    android:id="@+id/edtPostPrice"
                    style="@style/PostInput"
                    android:hint="@string/post_price_hint"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                style="@style/PostFormCard"
                android:layout_height="116dp">

                <TextView
                    style="@style/PostSectionTitle"
                    android:text="@string/post_location" />

                <TextView
                    android:id="@+id/tvPostLocation"
                    style="@style/PostSelectInput"
                    android:text="@string/post_select_location" />
            </LinearLayout>

            <LinearLayout
                style="@style/PostFormCard"
                android:layout_height="196dp">

                <TextView
                    style="@style/PostSectionTitle"
                    android:text="@string/post_description" />

                <EditText
                    android:id="@+id/edtPostDescription"
                    style="@style/PostDescriptionInput"
                    android:gravity="top|start"
                    android:hint="@string/post_description_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="5" />
            </LinearLayout>

            <!-- Nút submit đặt ngoài các thẻ để giữ đúng khoảng cách theo thiết kế. -->
            <TextView
                android:id="@+id/btnSubmitPost"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_post_submit"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/post_submit"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
