    <!-- Mảng đầu tiên là text tiếng Việt hiển thị trên UI; mảng thứ hai giữ giá trị cũ gửi về API. -->
    <string-array name="post_category_options">
        <item>Sách giáo trình</item>
        <item>Thiết bị thí nghiệm</item>
        <item>Đồ điện tử</item>
    </string-array>

    <string-array name="post_category_api_values">
        <item>Textbooks</item>
        <item>Lab Equipment</item>
        <item>Electronics</item>
    </string-array>

    <string-array name="post_location_options">
        <item>Ký túc xá A - Phòng 305</item>
        <item>Ký túc xá B - Phòng 201</item>
        <item>Thư viện</item>
        <item>Căn tin</item>
    </string-array>

    <!-- Theme của màn Post chỉ đổi nền màn hình, không chỉnh theme chung của app. -->
    <style name="Theme.EduShare.Post" parent="Theme.EduShare">
        <item name="android:windowBackground">@color/post_background</item>
    </style>

    <!-- Style dùng lại giúp activity_post_item.xml tập trung vào cấu trúc layout. -->
    <style name="PostSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/post_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PostTypeButton">
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="PostFormCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/bg_post_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="PostInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_post_input</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/post_text_primary</item>
        <item name="android:textColorHint">@color/post_text_hint</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="PostSelectInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_post_input</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="PostConditionChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_post_chip_inactive</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">#4B5563</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PostDescriptionInput" parent="PostInput">
        <item name="android:layout_height">120dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:maxLines">6</item>
    </style>
</resources>