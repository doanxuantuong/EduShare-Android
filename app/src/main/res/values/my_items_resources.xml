    <string name="my_items_edit">Sửa</string>
    <string name="my_items_empty_state">Chưa có vật phẩm nào trong mục này</string>
    <string name="my_items_deleted_message">Đã xóa &quot;%1$s&quot; khỏi danh sách vật phẩm</string>
    <string name="my_items_delete_confirm_title">Xóa vật phẩm?</string>
    <string name="my_items_delete_confirm_message">Bạn có chắc muốn xóa &quot;%1$s&quot; khỏi danh sách vật phẩm không?</string>
    <string name="my_items_delete_confirm">Xóa</string>
    <string name="my_items_delete_cancel">Hủy</string>
    <string name="my_items_error_login_again">Vui lòng đăng nhập lại để xem vật phẩm của bạn</string>
