    <string name="desc_delete_my_item">Xóa vật phẩm của tôi</string>

    <!-- Theme riêng giúp màn My Items có nền đồng bộ nhưng vẫn kế thừa theme chung của app. -->
    <style name="Theme.EduShare.MyItems" parent="Theme.EduShare">
        <item name="android:windowBackground">@color/my_items_background</item>
    </style>

    <!-- Style cho các nút hành động trong card item để layout không bị lặp thuộc tính. -->
    <style name="MyItemsActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <string name="my_items_edit_coming_soon">Tính năng sửa sẽ được bổ sung sau</string>
    <string name="my_items_delete_coming_soon">Tính năng xóa sẽ được bổ sung sau</string>
